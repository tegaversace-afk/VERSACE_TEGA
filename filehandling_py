import json


def save_driver(driver):
  filename = f"{driver['name'].lower()}.json"

  with open(filename, "w") as file:
    json.dump(driver, file, indent=4)

  print(f"{driver['name']}'s record saved successfully.")


john = {"name": "John", "deliveries": 27, "wallet": 12000}

mary = {"name": "Mary", "deliveries": 30, "wallet": 16000}

