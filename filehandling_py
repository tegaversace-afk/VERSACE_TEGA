import json

def find_drivers():

    with open("drivers.json", "r") as file:
        drivers = json.load(file)

    experienced_drivers = []

    for driver in drivers:
        if driver["deliveries"] >= 30:
            experienced_drivers.append(driver)

    return experienced_drivers

def save_drivers(top_drivers):

    filename = "experienced_drivers.json"

    with open(filename, "w") as file:
        json.dump(top_drivers, file, indent=4)

    print("Experienced drivers saved successfully.")

top_drivers = find_drivers()

save_drivers(top_drivers)