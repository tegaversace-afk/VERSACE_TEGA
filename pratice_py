class Driver:
    pay_per_delivery = 1500
    next_id = 1
    def __init__(self, name, phone, vehicle, deliveries = 0, wallet = 0):
        self.driver_id = f"RE{Driver.next_id:03d}"
        Driver.next_id += 1
        self.name = name
        self.phone = phone
        self.vehicle = vehicle
        self.deliveries = deliveries
        self.wallet = wallet
        self.available = available
        self.bonus = 0
        self.fuel = 0
        self.credited_bonus = 0
        self.credited_fuel = 0

    def calculate_bonus(self):
        if self.deliveries >= 20:
            return 5000
        else:
            return 0
    def calculate_fuel(self):
        if self.deliveries >= 30:
            return 1000
        else:
            return 0

    def calculate_earnings(self):
        return self.deliveries * Driver.pay_per_delivery

    def add_delivery(self):
        self.deliveries += 1

    def update_wallet(self):
        self.bonus = self.calculate_bonus()
        self.fuel = self.calculate_fuel()
        new_bonus = self.bonus - self.credited_bonus
        new_fuel = self.fuel - self.credited_fuel
        self.wallet += new_bonus +  new_fuel
        self.credited_bonus = self.bonus
        self.credited_fuel = self.fuel

    def complete_delivery(self):
        self.add_delivery()
        self.update_wallet()
        self.go_online()

    def update_phone(self, new_phone):
        self.phone = new_phone

    def update_vehicle(self, new_vehicle):
        self.vehicle = new_vehicle

    def show_earnings(self):
        earnings = self.calculate_earnings()
        print(f"Driver ID : {self.driver_id}")
        print(f"Driver : {self.name}")
        print(f"Phone     : {self.phone}")
        print(f"Vehicle   : {self.vehicle}")
        print(f"Deliveries : {self.deliveries}")
        print(f"Base Pay : {earnings :,}")
        print(f"Bonus : {self.bonus:,}")
        print(f"Fuel : {self.fuel:,}")
        print(f"Wallet: {self.wallet:,}")
        print("-" * 30)


class Delivery:
    next_id = 1

    def __init__(self, pickup, dropoff, customer):
        self.delivery_id = f"DEL{Delivery.next_id:03d}"
        Delivery.next_id += 1

        self.pickup = pickup
        self.dropoff = dropoff
        self.customer = customer
        self.status = "Pending"
        self.assigned_driver = None

    def complete(self):
        self.status = "Completed"

    def show_details(self):
        driver_name = self.assigned_driver.name if self.assigned_driver else "Unassigned"
        print(f"Delivery ID: {self.delivery_id}")
        print(f"Customer   : {self.customer}")
        print(f"Pickup     : {self.pickup}")
        print(f"Dropoff    : {self.dropoff}")
        print(f"Status     : {self.status}")
        print(f"Assigned To: {driver_name}")
        print("-" * 30)

class RouteEarner:

    def __init__(self):
        self.drivers = []
        self.deliveries = []

    def add_driver(self, driver):
        self.drivers.append(driver)

    def show_all_drivers(self):
        for driver in self.drivers:
            driver.show_earnings()

    def complete_delivery_for_all(self):
        for driver in self.drivers:
            driver.complete_delivery()

    def find_driver(self, name):
            for driver in self.drivers:
                if driver.name == name:
                    return driver
            return None

    def find_driver_by_id(self, driver_id):
        for driver in self.drivers:
            if driver.driver_id == driver_id:
                return driver
        return None

    def find_available_driver(self):
        for driver in self.drivers:
            if driver.available:
                return driver
        return None

    def assign_delivery(self):
        driver = self.find_available_driver()

        if driver is None:
            print("No available driver.")
        else:
            driver.complete_delivery()  
            driver.go_offline()          
            print(f"Delivery assigned to {driver.name} ")

    def register_driver(self, name, phone, vehicle):
        existing_driver = self.find_driver(name)

        if existing_driver is not None:
            print("Driver already registered.")
            return existing_driver

        new_driver = Driver(name, phone, vehicle)
        self.drivers.append(new_driver)
        return new_driver

    def assign_delivery(self, delivery):
        driver = self.find_available_driver()

        if driver is None:
            print(f"No available driver for Delivery {delivery.delivery_id}.")
        else:
            delivery.assigned_driver = driver
            delivery.complete()
            
            driver.complete_delivery()
            driver.go_offline()
            
            self.deliveries.append(delivery)
            print(f"Delivery {delivery.delivery_id} assigned to {driver.name} ({driver.driver_id}).")

    


