class Driver:
    pay_per_delivery = 1500
    next_id = 1
    def __init__(self, name, phone, vehicle, deliveries = 0, wallet = 0):
        self.driver_id = f"RE{Driver.next_id:03d}"
        Driver.next_id += 1
        self.name = name
        self.phone = phone
        self.vehicle = vehicle
        self.deliveries = deliveries
        self.wallet = wallet
        self.bonus = 0
        self.fuel = 0
        self.credited_bonus = 0
        self.credited_fuel = 0

    def calculate_bonus(self):
        if self.deliveries >= 20:
            return 5000
        else:
            return 0
    def calculate_fuel(self):
        if self.deliveries >= 30:
            return 1000
        else:
            return 0

    def calculate_earnings(self):
        return self.deliveries * Driver.pay_per_delivery

    def add_delivery(self):
        self.deliveries += 1

    def update_wallet(self):
        self.bonus = self.calculate_bonus()
        self.fuel = self.calculate_fuel()
        new_bonus = self.bonus - self.credited_bonus
        new_fuel = self.fuel - self.credited_fuel
        self.wallet += new_bonus +  new_fuel
        self.credited_bonus = self.bonus
        self.credited_fuel = self.fuel

    def complete_delivery(self):
        self.add_delivery()
        self.update_wallet()

    def show_earnings(self):
        earnings = self.calculate_earnings()
        print(f"Driver ID : {self.driver_id}")
        print(f"Driver : {self.name}")
        print(f"Phone     : {self.phone}")
        print(f"Vehicle   : {self.vehicle}")
        print(f"Deliveries : {self.deliveries}")
        print(f"Base Pay : {earnings :,}")
        print(f"Bonus : {self.bonus:,}")
        print(f"Fuel : {self.fuel:,}")
        print(f"Wallet: {self.wallet:,}")
        print("-" * 30)

class RouteEarner:

    def __init__(self):
        self.drivers = []

    def add_driver(self, driver):
        self.drivers.append(driver)

    def show_all_drivers(self):
        for driver in self.drivers:
            driver.show_earnings()

    def complete_delivery_for_all(self):
        for driver in self.drivers:
            driver.complete_delivery()

    def find_driver(self, name):
            for driver in self.drivers:
                if driver.name == name:
                    return driver
            return None

    def register_driver(self, name, phone, vehicle):
        existing_driver = self.find_driver(name)

        if existing_driver is not None:
            print("Driver already registered.")
            return existing_driver

        new_driver = Driver(name, phone, vehicle)
        self.drivers.append(new_driver)
        return new_driver


    def complete_delivery_for_driver(self, name):
        driver = self.find_driver(name)

        if driver is None:
            print("Driver not found.")
        else:
            driver.complete_delivery()
            print(f"{driver.name} completed a delivery.")