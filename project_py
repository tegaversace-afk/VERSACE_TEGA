students = [
    {"name": "Tega", "score": 95},
    {"name": "Amadi", "score": 82},
    {"name": "Sarah", "score": 76},
    {"name": "John", "score": 60}
]

for student in students:
    score = student["score"]

    if score >= 90:
        grade = 'A'
    elif score >= 80:
        grade = 'B'
    elif score >= 70:
        grade = 'C'
    elif score >= 60:
        grade = 'D'
    else:
        grade = 'F'


    print(student['name'], ':', student['score'], '-> Grade', grade)

